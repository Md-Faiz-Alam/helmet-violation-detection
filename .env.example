# Environment variables used by this project. Never commit real values.
# They are read from the environment (this file is NOT loaded automatically).
# PowerShell:  $env:ROBOFLOW_API_KEY="your_key"
# Mac/Linux:   export ROBOFLOW_API_KEY=your_key

# Needed only to download the dataset (docs/DEVELOPMENT.md > Dataset). On Kaggle, use Add-ons > Secrets instead.
ROBOFLOW_API_KEY=your_roboflow_private_api_key

# Optional: weights used by the older Streamlit demo (default: models/best.pt)
MODEL_PATH=models/best.pt

# The author's key: whoever has it can see and change everything. 32+ random characters; make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the real value in .env (never committed) for docker compose, and in Azure as a secret for the live site.
RIDESAFE_ADMIN_TOKEN=

# API settings (all optional; full list and defaults in backend/ridesafe/settings.py)
# RIDESAFE_DEMO=true                 default: plates masked for visitors (the author sees them in full)
# RIDESAFE_CORS_ORIGINS=https://...  the web app's address (default * allows any site to call the API)
# RIDESAFE_UPLOAD_TTL_S=3600         delete uploads and results after this many seconds (0 = keep)
# RIDESAFE_RATE_DETECT=30            photo checks per minute per visitor; RIDESAFE_RATE_UPLOADS=10 videos per hour
# RIDESAFE_SAMPLE_DIR=samples/demo_job   read-only sample job (python -m ridesafe.jobs --make-sample <video>)
