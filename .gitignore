# Python cache
__pycache__/
*.egg-info/
*.pyc
*.pyo
*.pyd
.DS_Store

# Virtual environments
.venv/
venv/
env/

# Secrets
.env

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Dataset (download from Roboflow, see docs/DEVELOPMENT.md). Only the config is tracked.
data/*
!data/data.yaml

# Training & detection outputs
runs/
results/

# Downloaded pretrained weights (Ultralytics saves them in the working dir)
yolov8*.pt
yolo11*.pt
yolo26*.pt

# Exported ONNX models (regenerate with scripts/export_onnx.py; models/best.pt is the source)
models/*.onnx

# Streamlit local config
.streamlit/

# IDE / OS files
.vscode/
.idea/
*.swp
Thumbs.db

# Video ground-truth review images (faces; regenerate with scripts/video_gt_draft.py)
eval/video_gt/review_*/
